    "@ledgerlands/game-engine": "0.1.0",
    "@ledgerlands/shared-types": "0.1.0",
    "fastify": "5.12.5",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "tsx": "4.23.15",
    "vitest": "5.0.1"
  }
}
